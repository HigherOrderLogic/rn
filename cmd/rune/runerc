# LSP configuration
lsp:
  # Determine the icons used on the auxiliary bar, when rendering LSP diagnostics,
  # if 'editor.aux_bar.icons' is set to true and so displaying icons on the
  # side bar is enabled.
  icons:
    error: "✖"
    warning: "▲"
    information: "◉"
    hint: "󰌵"

