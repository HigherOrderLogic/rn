# the keys in 'extensions' are arbitrary and for
# identification purposes only. They contain the
# path and configuration for each of the extensions
# that are to be run alongside the editor.
extensions:
  # This extension adds a command colorPalette which opens a new window
  # and shows all the colors available to configure in the various
  # styles thorought this configuration.
  color_palette: {}
  # This extension adds a fuzzy file search component to the editor. Open
  # via searchfile command.
  fuzzy_file:
    config:
      ## Command to use instead of native list files implementation.
      ## The recommended commands are the silver searcher and ripgrep.
      #command: rg -l ""
      # Whether search is case sensitive
      case_sensitive: true
      # Search algorithm. Options are fuzzy, contains and equal.
      algo: fuzzy
      # Key binding used to cycle through history.
      history_key: <m-p>
      # Max history stored
      history: 50000
      # Colors
      element_attr:
        fg: default
        bg: default
        flags:
          - dim
      matched_text_attr:
        fg: blue
        bg: default
        flags:
          - bold
      count_attr:
        fg: default
        bg: default
      focus_element_attr:
        fg: purple
        bg: default
  # This extension adds a fuzzy file line search component to the editor. Open
  # via searchtext command.
  fuzzy_line:
    config:
      ## Command to use instead of native list files implementation.
      ## The recommended commands are the silver searcher and ripgrep.
      #command: rg --color never -n --no-heading --max-columns 500 ""
      # Whether search is case sensitive
      case_sensitive: true
      # Search algorithm. Options are fuzzy, contains and equal.
      algo: fuzzy
      # Key binding used to cycle through history.
      history_key: <m-\\>
      # Max history stored
      history: 2000
      # Colors
      element_attr:
        fg: default
        bg: default
        flags:
          - dim
      matched_text_attr:
        fg: blue
        bg: default
        flags:
          - bold
      count_attr:
        fg: default
        bg: default
      focus_element_attr:
        fg: purple
        bg: default
# Configuration for the command prompt.
command:
  # Key to open the command prompt.
  key: ":" # if editor.mode = "modal"
  # Key to toggle between command list and command history in the prompt.
  history_key: "<m-r>"
  # Max number of commands stored in history.
  max_history: 20000
  # Configure arbitrary command alises.
  aliases:
    # Aliases can be used to prioritize commands over others. For instance
    # when typing 'e', tipically 'echo' would take priority. We can
    # add an alias from 'e' to 'edit' to change that.
    e:
      command: edit # the command that we want to trigger or a list of commands:
        # - commandA
        # - commandB
      # completer options are 'history', 'files', 'dirs', '! <command>'
      # or a list of hardcoded options:
      completer: files
        # - optionA
        # - optionB
    w: write
    # If an alias includes '$<number>' as an argument
    # it will be replaced as the positional argument passed to dispatched alias.
    # If a command includes '%' as an argument, it will be replaced with
    # the current file path. To escape a '%' character, you can pass '%%',
    # and the same can be done for escaping a dollar sign: $$1 is passed as $1,
    # rather than substituting it for the first argument to an alias.
    # For instance, invoking 'sed s/foo/bar/g', will result
    # in the following ! gsed -i s/foo/bar/g <filename>
    sed: "!! gsed -i $1 %"

    # Furthermore, aliases can be used to create shortcuts to command
    # and argument combinations that are recurrently used. If we want to
    # use the default completer (history), a simple string to string
    # mapping is sufficient.
    gitnextchange: jumptolocation next gitchange
    gitprevchange: jumptolocation previous gitchange
    lspnextdiagnostic: jumptolocation next lsp-diagnostics
    lspprevdiagnostic: jumptolocation previous lsp-diagnostics

    # You can also add combinations of commands to be run
    # as a single command.
    # searchtext and searchfile can be tailored to specific use cases
    # by passing a program that applies different filters.
    # searchtextnotest: searchtext rg -n --no-heading -g '!*test.go' ""
    searchdiff: searchtext git diff -U0 --no-ext-diff | awk '/^diff --git|^diff --cc/ { file = $3; sub(/^a\//, "", file); } /^@@/ || /^@@@/ { split($3, nums, ","); gsub(/[^0-9]/, "", nums[1]); line_number = nums[1]; first_change = 1; } /^[-+]/ && first_change { print file ":" line_number ":" " " $0; first_change = 0; }'
    gitblame: "! git blame %"
    gitdiff: "! git diff"
    shadercancel: shaderrun nop 500ms
    # echo is a powerful command that allows you to programmatically inject
    # keyboard events back into the event loop, enabling more powerful commands.
    # The {prompt} instruction can be used to generically open the command prompt,
    # without having to worry about the key combination used to open the command prompt.
    tabnew: echo {prompt}edit<space>
    tabsearch: echo {prompt}tabfocus<space>
    workspacesearch: echo {prompt}workspacefocus<space>
    # The {wait} instruction can be used to wait for the command prompt
    # search list completion to finish.
    # For example, the following alias utilizes the power of echo to repeat
    # the last echo sequence.
    # editfirst: echo {prompt}edit<space>{wait}<tab><enter>
    searchfunc: echo {prompt}searchast<space>locals.scm<space>local.definition.method|local.definition.function<enter>
    searchvar: echo {prompt}searchast<space>locals.scm<space>local.definition.var<enter>
    searchtype: echo {prompt}searchast<space>locals.scm<space>local.definition.type<enter>
    # git worktree commands
    worktreenew:
      - '!! git worktree add "$RUNE_DATADIR/worktrees/$1" -b $1'
      - workspacenew $RUNE_DATADIR/worktrees/$1
      - workspacerename $1
    worktreeopen:
      command:
        - workspacenew $RUNE_DATADIR/worktrees/$1
        - workspacerename $1
      completer: '! $SHELL -c ''git worktree list | tail -n +2 | cut -d" " -f1 | xargs -n1 basename'''
    worktreeremove:
      command: '!! git worktree remove $1'
      completer: '! $SHELL -c ''git worktree list | tail -n +2 | cut -d" " -f1 | xargs -n1 basename'''
