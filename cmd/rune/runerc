  # Define the positive or negative line height offset applied to the
  # default line height.
  #line-height-offset: 0

  # Set the DPI. By default DPI is calculated dynamically based
  # on the monitor's device scale factor. If set manually,
  # the DPI will not be re-calculated when moving across screens
  # with different device scale factors.
  #dpi: 72

  # Enables or disables transparent window rendering, effectively enabling
  # or disabling the guiopacity command.
  enable_transparent_window: true

  # Sets the initial window opacity,
  # if enable_transparent_window is set to true.
  window_opacity:
    fg: 1
    bg: 1

  # Sets the initial window background blur,
  # if enable_transparent_window is set to true,
  # and the window background opacity is not 1.
  window_blur_radius: 100

  # Define arbitrary environment variables to be inherited
  # by all processes spawn by the GUI.
  #env:
  #  my_var: my_val

  # Enable or disable font ligatures. Font ligatures are a typographic
  # feature that joins two or more letters into a single glyph or
  # shape, at the expense of rendering performance (i.e. =>, ->, etc.)
  ligatures: false

# clipboard defines whether to use the system clipboard
# or not ('system' vs 'memory'). If system is used, then
# copy and paste functions are shared with the host system.
clipboard: "system"

editor:
  # mode determines what kind of editor to use. Options are
  # 'modal', which simulates vi/vim and 'modeless' which
  # works like the rest of text editors.
  mode: modal
  modal:
    # default text attributes
    attr:
      fg: default
      bg: default
    # search and message bar attributes
    bar_attr:
      fg: default
      bg: default
    # search results attributes
    search_attr:
      fg: grey
      bg: yellow
  # Enable or disable syntax-driven indentation.
  autoindent: true
  # Highlights are the colors and styles to be used for syntax highlighting.
  highlights:
    function:
      fg: default
    function.builtin:
      fg: yellow
    function.method:
      fg: default
    type:
      fg: default
    property:
      fg: default
    variable:
      fg: default
    operator:
      fg: default
    keyword:
      fg: yellow
    string:
      fg: magenta
    escape:
      fg: default
    number:
      fg: red
    constant.builtin:
      fg: default
    comment:
      fg: blue
    markup.heading:
      fg: yellow
      flags: bold
    markup.raw:
      fg: magenta
    markup.raw.delimiter:
      fg: yellow
    markup.link:
      fg: cyan
      flags: underline
    markup.link.url:
      fg: cyan
      flags: underline
    markup.link.label:
      fg: yellow
      flags: underline
    markup.link.text:
      fg: cyan
      flags: underline
    markup.list:
      fg: yellow
      flags: bold
    markup.quote:
      fg: blue
      flags: italic
    markup.strong:
      fg: yellow
      flags: bold
    markup.italic:
      fg: yellow
      flags: italic
    markup.strikethrough:
      fg: blue
      flags: strikethrough
    markup.underline:
      fg: yellow
      flags: underline
    markup.math:
      fg: magenta
    text.title:
      fg: yellow
      flags: bold
    text.literal:
      fg: magenta
    text.uri:
      fg: cyan
      flags: underline
    text.reference:
      fg: yellow
      flags: underline
    text.emphasis:
      fg: yellow
      flags: italic
    text.strong:
      fg: yellow
      flags: bold
  # status_bar section configures the editor's bottom status bar.
  status_bar:
    # enabled determines whether the editor renders the status bar at all
    enabled: true
    # layout determines the layout of the status bar.
    # The following components are available:
    #  - Status: the status message determined by the editor.
    #  - Filepath: the path of the file being edited, relative to the workspace.
    #  - GitShortRef: the git reference pointed at by HEAD.
    #  - GitDiffAdd: the number of lines added.
    #  - GitDiffDel: the number of lines deleted.
    #  - ShiftRight: up until this component, all components are aligned left.
    #  - CursorColumn: cursor column
    #  - CursorLine: cursor line
    #  - TotalLines: total number of lines in the file
    #  - Language: language parser status indicator
    # Each component can have custom attributes via a pipe operator "|".
    # The supported functions are the following:
    #  - bg <color>: set the background color as a hex value or a W3C named color.
    #  - fg <color>: set the foreground color as a hex value or a W3C named color.
    #  - bold: set the text style as bold
    #  - italic: set the text style as italic
	#  - underline: set the text style as underline
	#  - reverse: reverse the text foreground and background
	#  - dim: dim the foreground color
    # The specified attributes are applied to nearby cells, until a double blank
    # space is encountered. This allows applying attributes to contiguous component
    # suffixes and prefixes precisely. For example, the following "red" background
    # applies to the Filepath component and the "file" string, whereas the "blue"
    # background applies to the "<" prefix, the TotalLines component and the ">" suffix:
    # layout: '{{ .Filepath | bg "red" }} file  <{{ .TotalLines | bg "blue" }}>'
    layout: ' {{ .Status | bg "red" | fg "white" | bold }} █▓▒░  {{ .Filepath | fg "silver" }}  {{ .GitShortRef | fg "silver" }}   {{ .GitDiffAdd | fg "green" }}   {{ .GitDiffDel | fg "red" }} {{ .ShiftRight }} {{ .CursorColumn | fg "silver" }}:{{ .CursorLine | fg "silver" }}  {{ .TotalLines | fg "silver" }} lines  ░▒▓█ {{ .Language | bold | fg "silver" | bg "red"}} '
    # background_attr determines the default background field of all the bar's components,
    # for instance, when a component's attributes are not specified via
    # layout, i.e. {{ .Status | bg "red" }}.
    background_attr:
      bg: gray
    # foreground_error_attr determines the error color attributes for errors
    # displayed at the status bar. Both 'bg' and 'flags' properties are ignored.
    foreground_error_attr:
      fg: yellow
  # aux_bar section configures the editor's auxiliary bar on the left,
  # which is a vertical bar with line-wise data, situated on the left side
  # of every open file tab.
  aux_bar:
    # enabled determines whether the editor renders the auxiliary bar at all.
    enabled: true
    # folds enables or disables rendering fold marks.
    folds: true
    # git enables or disables rendering the diff between
    # the open file's work tree and HEAD. Options are:
    # - bar: render a separate bar for diff data
    # - inline: color line numbers if 'lines' option is enabled.
    # - all: combine 'inline' with 'bar'
    # - disabled: no git information is displayed
    git: inline
    icons: true
    # lines enables or disables rendering the line number.
    # options are 'disabled', 'absolute' and 'relative'.
    lines: absolute
    # highlight_cursor determines whether to highlight the cursor
    # position at the bar.
    highlight_cursor: true
    git_del_inline_attr:
      fg: maroon
      flags: bold
    git_add_inline_attr:
      fg: green
      flags: bold
    git_del_locations_attr:
      bg: maroon
      flags: dim
    git_add_locations_attr:
      bg: green
      flags: dim
    line_number_attr:
      fg: gray
      bg: default
    highlight_cursor_attr:
      fg: white
      bg: gray
      flags: bold
  # initial_folds determines whether the editor hides certain folds,
  # which vary by language, when opening a file.
  initial_folds: true
  # Icons for tabs. If the file extension
  # is in the given map, the given character is used as icon,
  # otherwise 'default' is used.
  # Subsequent workspaces use subsequent codepoints in the font.
  # The key 'terminal' is used to configure the icon of a terminal's tab.
  icons:
    default: 
    terminal: 
