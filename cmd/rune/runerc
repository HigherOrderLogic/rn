browser:
  # When multiple workspaces are open, this setting controls what the
  # workspace bar shows: the workspace’s simplified path ("path"),
  # its number only ("number"), or nothing at all (false), effectively disabling
  # the bar.
  workspace_bar: path
  window_manager:
    dim: true
    frame: *frame
    frame_attr: *frame_attr
    focus_frame_attr: *focus_frame_attr
    frame_charset: *frame_charset
    focus_frame_charset: *focus_frame_charset
    scroll_bar_attr:
      fg: blue
      bg: default
    scroll_bar_char: '▐'
    scroll_bar_hover_char: '█'
  union_frames: false
  frameunion_charset: *frameunion_charset
  # separator characters used to space out tab names
  tab_name_separator: "   "
  focus_tab_attr:
    fg: blue
    bg: default
    flags:
      - bold
  dirty_tab_attr:
    fg: red
    bg: default
    flags:
      - italic
  non_focus_tab_attr:
    fg: default_dim
    bg: default
  # Prompt configuration. This prompted is used by the editor
  # to ask questions to the user.
  prompt:
    # Colors
    text_attr:
      bg: gray
      flag: bold
    highlight_attr:
      bg: red
      flag: bold
    background_attr:
      fg: default
      bg: default

# Workspaces configuration. This configuration is never reloaded.
workspace:
  # Configuration for remote workspaces to connect over SSH.
  ssh:
    # Use a shell different than the one configured by the remote system.
    # shell: ""
    # Maximum amount of time for the TCP connection to establish.
    timeout: 5s
    # private_keys:
    #  - ~/.ssh/id_rsa
    # Instead of using private_keys and a go native implementation
    # of ssh, use the given command to start an ssh session. This could be
    # useful for environments which deploy a highly customized ~/.ssh/config.
    # The command should contain '%h' to subsitute for the workspace's host
    # and '%p' if custom ports are needed. If this option is set, private_keys,
    # insecure, and timeout are ignored.
    # command: ssh -q %h

  # Whether to automatically restore the previous session's files, terminal sessions
  # and window layout. If set to false, the user is asked via a prompt.
  auto_restore: true

  # Workspace wallpaper
  # Override the default Rune wallpaper with your ASCII art.
  #wallpaper: myAsciiArt

  # Override the default Rune wallpaper with a PNG image that
  # gets encoded into ASCII.
  #wallpaper_image: /path/to/image.png

  # Density characters used to encode wallpaper_image. They should be sorted
  # from less density to more density, i.e. '   `_.,-*=+:;cba!?0123456789$W#@'
  #wallpaper_density_characters: ' ▓▓▓▓'

  # The following attributes do not apply to the default wallpaper
  wallpaper_attr:
    fg: blue
    bg: default
  wallpaper_background_attr:
    bg: default

notifications:
  auto_close: 5s
  padding: 1
  progress_bar: true
  progress_format:
    start: "\U00100000"
    current: "\U00100001"
    current_tip: "\U00100002"
    remain: "\U00100003"
    end: "\U00100004"
  attr:
    fg: default
    bg: default
  background_attr:
    fg: default
    bg: default
  frame_charset: *frame_charset

terminal:
  # Default shell to use rather than what's provided by the OS via $SHELL.
  #shell: bash
  # Whether to respect the title set by the shell.
  dynamic_tab_name: true
  # Whether to enable the terminal's modal mode when pressing <esc>.
  modal: true
  # Overrides the default trigger to move the cursor to the start of the prompt line
  # and trigger the bell (the terminal's audible bell) with a custom escape sequence. This
  # setting is required to use the terminal's modal mode for non-standard shells (i.e. fish)
  # which don't trigger a bell with the default escape sequence.
  # This usually requires configuration on the shell side: for instance to bind an escape sequence
  # to the bell trigger when using the fish shell, you can add the following to your fish shell config:
  # `bind \cg 'printf "\a"'`. Furthermore, it's important to note that it's assumed that after calling
  # this trigger, the cursor is at the start of the line, thus if shell doesn't support ctrl-a to move
  # to the start of the line, a key sequence for that must be mapped as well.
  # For example, the following is the bell trigger for <ctrl-a><ctrl-g>:
  #bell_trigger: "\x01\x07"
  # Max terminal lines. Increasing this value slows down terminal resizing linearly.
  max_lines: 1000
  # This determines the initial number of terminal emulator instances to allocate in the
  # reservoir, effectively speeding up opening new terminal emulators. You should change
  # this if your shell is slow at initializing.
  # A value of 0 deactivates the reservoir and all new terminals will be freshly initialized.
  initial_reservoir: 0
  # Colors
  attr:
    fg: default
    bg: default
  selection_attr:
    flags: reverse
  # Defines the tab name attributes when a bell is received and
  # window is not in focus.
  needs_attention_attr:
    fg: red
    flags: blink
  # plugin configures the behavior of programs executed via the `!` command.
  plugin:
    # bar_layout determines the layout of the either top or bottom status bar.
    # The following components are available:
	#  - Command: renders the full command and args of the running program.
	#  - StatusIcon: renders the status of the program as an icon or animation if running.
	#  - ExitStatus: renders the exit status after the program is done running.
	#  - Elapsed: renders the time the program has been running.
	#  - AlignRight: indicates that the following components need to be aligned to the right.
	#  - AlignCenter indicates that the following components need to centered.
    # Each component can have custom attributes via a pipe operator "|".
    # The supported functions are the following:
    #  - bg <color>: set the background color as a hex value or a W3C named color.
    #  - fg <color>: set the foreground color as a hex value or a W3C named color.
    #  - bold: set the text style as bold
    #  - italic: set the text style as italic
	#  - underline: set the text style as underline
	#  - reverse: reverse the text foreground and background
	#  - dim: dim the foreground color
    # The specified attributes are applied to nearby cells, until a double blank
    # space is encountered. This allows applying attributes to contiguous component
    # suffixes and prefixes precisely:
    # bar_layout: '{{ .StatusIcon | fg "yellow" | bg "red" }} RED  <{{ .Elapsed | bg "blue" }}>'
    # For example, in this case the "red" background applies to the StatusIcon component and
    # the "RED" string, whereas the "blue" background applies to the "<" prefix,
    # the Elapsed component and the ">" suffix.
    bar_layout: ' {{ .StatusIcon | bg "gray" | fg "white" }} █▓▒░{{ .AlignCenter}}{{ .Command | fg "white" | bold }}{{ .AlignRight }}  ░▒▓█ {{ .Elapsed | fg "white" | bg "gray" }} '
    status_error_icon: ""
    status_error_attr:
      fg: red
    status_success_icon: ""
    status_success_attr:
      fg: green
    animation: "⠃⠅⠆⠘⠨⠰⠉⠒⠤⠑⠡⠢⠊⠌⠔⠇⠸⠎⠱⠣⠜⠪⠕⠋⠙⠓⠚⠍⠩⠥⠬⠖⠲⠦⠴⠏⠹⠧⠼⠫⠝⠮⠵⠺⠗⠞⠳⠛⠭⠶⠟⠻⠷⠾⠯⠽⠿"
    bar_background_attr:
      bg: default
    # Determines whether bar should be rendered at the bottom or the top.
    bar_align_bottom: false
