# These are variables referenced thorought this file.
# Colors can be either a W3C color name, a hex string value (i.e. #ffffff),
# or the string "default", which indicates that the default terminal
# text color should be used.

# If your terminal doesn't support RGB colors, you can
# see the full list of traditional colors and its values
# by invoking the colorPalette command, provided by the 'colors'
# extension below (extension_color_palette).
color_theme_1: &default default
color_theme_2: &highlight '#c6c6c6'
color_theme_3: &background '#1e1e1e'
color_theme_4: &highlight2 '#00AFFF'
color_theme_5: &framecolor '#3a3a3a'
color_theme_6: &background2 '#1e1e1e'

# If your terminal supports RGB colors, then you might enjoy
# the following theme better.
#
# color_theme_1: &default default
# color_theme_2: &highlight '#ef85d7'
# color_theme_3: &background '#231b2e'
# color_theme_4: &highlight2 '#7bf5f4'
# color_theme_5: &framecolor '#541862'
# color_theme_6: &background2 '#231b2e'

frame_theme: &frame true
focus_frame_charset_theme: &focus_frame_charset
  horizontaltop: '─'
  horizontalbottom: '─'
  verticalright: '│'
  verticalleft: '│'
  topleft: '┌'
  topright: '┐'
  bottomleft: '└'
  bottomright: '┘'
frame_charset_theme: &frame_charset
  horizontaltop: '─'
  horizontalbottom: '─'
  verticalright: '│'
  verticalleft: '│'
  topleft: '┌'
  topright: '┐'
  bottomleft: '└'
  bottomright: '┘'
frameunion_charset_theme: &frameunion_charset
  left: '├'
  right: '┤'
  top: '┬'
  bottom: '┴'
frame_attr_theme: &frame_attr
  fg: *framecolor
  bg: *background
focus_frame_attr_theme: &focus_frame_attr
  fg: *highlight
  bg: *background
  flags: dim

# file to log to. This property is not reloaded on reloadWorkspace.
log_path: ~/.six/debug.log
# log level. This property is not reloaded on reloadWorkspace.
log_level: info # error, debug, trace
# input mode list. Options are 'esc', 'mouse' and 'alt'.
# Reference termbox input modes for more details.
input_mode:
  - esc
  - mouse

# clipboard defines whether to use the system clipboard
# or not ('system' vs 'memory'). If system is used, then
# copy and paste functions are shared with the host system.
clipboard: "system"

editor:
  # mode determines what kind of editor to use. Options are
  # 'modal', which simulates vi/vim and 'modeless' which
  # works like the rest of text editors.
  mode: modal
  modal:
    wrap: false # true for wrapping lines
    # default text attributes
    attr:
      fg: *default
      bg: *background2
    # search and message bar attributes
    bar_attr:
      fg: *default
      bg: *background2
    # search results attributes
    search_attr:
      fg: *default
      bg: *background2
      flags: reverse
  modeless:
    wrap: false # true for wrapping lines
    # default text attributes
    attr:
      fg: *default
      bg: *background2
    # search and message bar attributes
    bar_attr:
      fg: *default
      bg: *background2
    # search results attributes
    search_attr:
      fg: *default
      bg: *background2
      flags: reverse

# the keys in 'extensions' are arbitrary and for
# identification purposes only. They contain the
# path and configuration for each of the extensions
# that are to be run alongside the editor.
extensions:
  # This extension adds AI assistant commands to the editor. Open a new
  # dialogue with 'assistantChat' command or run a query through it directly
  # with '?' command.
  ai:
    path: /usr/local/bin/extension_ai
    config:
      # default LLM model used by all commands. The assistantChat command
      # allows overriding this setting. Check its manual for more details.
      default_model: gpt-4-0125-preview
      # default_model: "llama-2-7b-32k-instruct.Q5_K_M"

      # Provider (i.e. OpenAI) API key
      # api_key: ""

      # Overrides provider's base URL. Default is set to openai's.
      # base_url: http://localhost:8080/v1

      # Available models is map of model name to max context window
      # which limits which models are allowed dynamically or via
      # default_model
      available_models:
        gpt-4-0125-preview: 128000
        gpt-4-turbo-preview: 128000
        gpt-4-1106-preview: 128000
        gpt-4: 8192
        gpt-3.5-turbo: 8192
        gpt-3.5-turbo-1106: 8192
        # llama-2-7b-chat.Q4_K_M: 4096

      # Colors
      background_attr:
        bg: *background
      user_msg_attr:
        fg: *default
        bg: *background
        flags: dim
      assistant_msg_attr:
        fg: *default
        bg: *background
        flags: italic
      input_box_attr:
        fg: *default
        bg: *background
      input_placeholder_attr:
        fg: *highlight
        bg: *background
      input_box_frame_attr:
        fg: *default
        bg: *background

       # frequency_penalty: 0
       # presence_penalty: 0
       # max_tokens: 120
       # temperature: 0.9
       # top_p: 1
       # initial_context: You are a helpful coding assistant.

  # This extension is used for navigating the editor's issue
  # tracker and creating new issues.
  rtc:
    path: /usr/local/bin/extension_rtc
    config:
      # Whether to capture and send ascii images in color
      color: true
      # Frames per second for capture
      fps: 30
      # Ranges from -100 to 100, it indicates whether
      # contrast should be increased to provide clearer frames.
      contrast: 30
  # This extension is used as a general purpose syntax highlighter.
  # It's based off https://github.com/alecthomas/chroma.
  lexer:
    path: /usr/local/bin/extension_lexer
    config:
      set_background_attr: false
      # See https://github.com/alecthomas/chroma/tree/master/styles
      # for a full list of styles.
      default_style: six
      # override default style by file extension. 'disabled' disables
      # this extension for a file extension.
      styles:
        # .go: tango
        .rb: disabled
  # This extension is for simulating a extension panic or other type of debugging.
  chaos:
    path: /usr/local/bin/extension_chaos
  # This extension adds a new scheme "upspin" which implements
  # e2e encrypted workspaces. If you're interested in this feature
  # please follow instructions here: https://upspin.io/doc/signup.md.
  upspin:
    path: /usr/local/bin/extension_upspin
  # This extension adds a command colorPalette which opens a new window
  # and shows all the colors available to configure in the various
  # styles thorought this configuration.
  color_palette:
    path: /usr/local/bin/extension_color_palette
  # This extension adds a command openFileUnderCursor, which does just that.
  open_file_cursor:
    path: /usr/local/bin/extension_open_file_cursor
  # This extension adds a sed command to run sed scripts against the current file.
  sed:
    path: /usr/local/bin/extension_sed
  # This extension enables visualizing log files with the log command. If command
  # is passed without any arguments, the editor's log file is opened.
  logs:
    path: /usr/local/bin/extension_logs
  # This extension adds a file information bar at the bottom.
  file_bar:
    path: /usr/local/bin/extension_file_bar
    config:
      # Whether to show if a file has been modified.
      show_dirty: true
      # Colors
      filename_attr:
        fg: *default
        bg: *background
      background_attr:
        fg: *default
        bg: *background
      filename_dirty_attr:
        fg: *highlight2
        bg: *background
      coordinates_attr:
        fg: *default
        bg: *background
  # This extension adds a git changes bar to the left of the open file.
  git:
    path: /usr/local/bin/extension_git
    config:
      # Colors
      bar_attr:
        fg: *default
        bg: *background
      add_attr:
        fg: *default
        bg: green
      del_attr:
        fg: *default
        bg: red
  # This extension adds a fuzzy AST search component to the editor.
  # It adds searchSyntaxFunctions, searchSyntaxTypes and searchSyntaxTypes
  # commands, which use an abstraction layer to effectively query each file in the
  # workspace based on each of the programming languages supported.
  # It also adds searchSyntax command which allows passing an arbitrary query.
  # See https://tree-sitter.github.io/tree-sitter/using-parsers#query-syntax
  # for a tutorial on how to craft queries.
  fuzzy_syntax:
    path: /usr/local/bin/extension_fuzzy_syntax
    config: {}
  # This extension adds a fuzzy file search component to the editor. Open
  # via searchFile command.
  fuzzy_file:
    path: /usr/local/bin/extension_fuzzy_file
    config:
      ## Command to use instead of native list files implementation.
      ## The recommended commands are the silver searcher and ripgrep.
      #command: rg -l ""
      # Whether search is case sensitive
      case_sensitive: true
      # Search algorithm. Options are fuzzy, contains and equal.
      algo: fuzzy
      # Key binding used to cycle through history.
      history_key: <c-p>
      # Max history stored
      history: 50000
      # Colors
      element_attr:
        fg: *default
        bg: *background
      matched_text_attr:
        fg: *highlight2
        bg: *background
        flags:
          - bold
      count_attr:
        fg: *default
        bg: *background
      focus_element_attr:
        fg: *highlight
        bg: *background
        flags:
          - bold
  # This extension adds a fuzzy file line search component to the editor. Open
  # via searchText command.
  fuzzy_line:
    path: /usr/local/bin/extension_fuzzy_line
    config:
      ## Command to use instead of native list files implementation.
      ## The recommended commands are the silver searcher and ripgrep.
      #command: rg --color never -n --no-heading --max-columns 500 ""
      # Whether search is case sensitive
      case_sensitive: true
      # Search algorithm. Options are fuzzy, contains and equal.
      algo: fuzzy
      # Key binding used to cycle through history.
      history_key: <c-\>
      # Max history stored
      history: 2000
      # Colors
      element_attr:
        fg: *default
        bg: *background
      matched_text_attr:
        fg: *highlight2
        bg: *background
        flags:
          - bold
          - italic
      count_attr:
        fg: *default
        bg: *background
      focus_element_attr:
        fg: *highlight
        bg: *background
        flags:
          - bold
  # This extension adds LSP functionality (Language Server Protocol).
  # This adds formatting, go to definition, search references, get
  # symbol documentation, and diagnostics in the form of errors and warnings.
  # Only go and C/C++ is supported for now, but you're welcome to try
  # LSP servers by adding new rows below in `exec`.
  lsp:
    path: /usr/local/bin/extension_lsp
    config:
      # Hover window colors
      hover_window_attr:
        fg: *default
        bg: *background
      # Search references window colors
      references:
        window_attr:
          fg: *default
          bg: *background
        element_attr:
          fg: *default
          bg: *background
        matched_text_attr:
          fg: *highlight2
          bg: *background
          flags:
            - bold
            - italic
        count_attr:
          fg: *default
          bg: *background
        focus_element_attr:
          fg: *highlight
          bg: *background
          flags:
            - bold
      # timeout to connect to LSP server.
      connect_timeout: 10s
      # Timeout to run individual RPCs against LSP server.
      # This should be large for large workspaces.
      rpc_timeout: 30s
      disconnect_timeout: 300ms
      # configure syntax highlighting colors
      syntax_highlighting:
        interface: yellow
        struct: default
        typeParameter: default
        parameter: default
        variable:  default
        property: default
        enumMember: default
        event: default
        method: default
        function: default
        member: default
        macro: default
        keyword: yellow
        modifier: yellow
        comment: blue
        string: magenta
        number: red
      # Enable/disable syntax highlighting by file extension.
      # By default it's disabled.
      enable_semantic_tokens:
        # .go: false
        .rb: true
      # Enable a LSP server for a file extension. The format is
      # <.extension>: <path to lsp executable> <args>
      exec:
        .go: gopls -mode stdio
        .c: clangd
        .lua: lua-lsp
        .h: clangd
        .cpp: clangd
        .hpp: clangd
        .ts: typescript-language-server --stdio
        .tsx: typescript-language-server --stdio
        .json: typescript-language-server --stdio
        .swift: sourcekit-lsp
        .rs: /Users/ernestrc/.cargo/bin/rust-analyzer

# Configuration for the command prompt.
command:
  # Key to open the command prompt.
  key: ":"
  # Max number of commands stored in history.
  max_history: 20000
  # Configure arbitrary command alises.
  aliases:
    # aliases can be used to disambiguate commands from others,
    # creating shortcuts.
    ref: lspReferences
    issues: addWorkspace bluectl+issues:///
    config: edit ~/.sixrc
    # You can also add combinations of commands to be run
    # as a single command.
    splitWindowTerminal:
      - splitWindow
      - newTerminal
    layout:
      - splitWindowTerminal
      - focusPrevWindow
      - searchFile
  # Configure bindings from key combinations to commands.
  key_bindings:
    <c-w>: closeTab
    <c-l>: nextTab
    <c-h>: previousTab
    <c-x><c-h>: focusPrevWindow
    <c-x><c-l>: focusNextWindow
    <c-x><c-j>: focusBelowWindow
    <c-x><c-k>: focusAboveWindow
    <c-x><c-w>: closeWindow
    <c-x>h: changeSplitOrientation h
    <c-x>v: changeSplitOrientation v
    <c-j>: lspNextDiagnostic
    <c-k>: lspPrevDiagnostic
    <c-f>: toggleFullscreen
    <c-t>: lspHover
    <c-g>: lspGoToDefinition
    <c-b>: lspFormat
    <c-p>: searchFile
    <c-\>: searchText
    # Aliases can also be mapped to key combinations
    <c-x><enter>: splitWindowTerminal
    gf: openFileUnderCursor
    <c-x>1: switchToWorkspace 1
    <c-x>2: switchToWorkspace 2
    <c-x>3: switchToWorkspace 3
    <c-x>4: switchToWorkspace 4
    <c-x>5: switchToWorkspace 5
    <c-x>6: switchToWorkspace 6
    <c-x>7: switchToWorkspace 7
    <c-x>8: switchToWorkspace 8
    <c-x>9: switchToWorkspace 9
  # Colors
  element_attr:
    fg: *default
    bg: *background
  manual_attr:
    fg: *default
    bg: *background
  matched_text_attr:
    fg: *highlight2
    bg: *background
    flags:
      - bold
      - italic
  focus_element_attr:
    fg: *highlight
    bg: *background
    flags:
      - bold

browser:
  # Whether to add the URI of the workspace to the workspace bar
  workspace_bar_uri: false
  window_manager:
    dim: true
    frame: *frame
    frame_attr: *frame_attr
    focus_frame_attr: *focus_frame_attr
    frame_charset: *frame_charset
    focus_frame_charset: *focus_frame_charset
  frameunion_charset: *frameunion_charset
  focus_tab_attr:
    fg: *highlight
    bg: *background
    flags:
      - bold
  dirty_tab_attr:
    fg: *highlight2
    bg: *background
    flags:
      - italic
  non_focus_tab_attr:
    fg: *default
    bg: *background
  # Prompt configuration. This prompted is used by the editor
  # to ask questions to the user.
  prompt:
    # Colors
    text_attr:
      fg: *default
      bg: *background
    highlight_attr:
      fg: *highlight
      bg: *default
      flag: reverse
    background_attr:
      fg: *default
      bg: *background

# Workspaces configuration. This configuration is never reloaded.
workspace:
  # Configuration for upspin client to connect to workspaces.
  upspin:
    username: ernest@unstable.build
    dirserver: remote,upspin.unstable.build:443
    storeserver: remote,upspin.unstable.build:443
    packing: ee
  # Configuration for remote workspaces to connect over SSH.
  ssh:
    # Use a shell different than the one configured by the remote system.
    # shell: ""
    # Maximum amount of time for the TCP connection to establish.
    # timeout: 5s
    # private_keys:
    #  - ~/.ssh/id_rsa
    # Instead of using private_keys and a go native implementation
    # of ssh, use the given command to start an ssh session. This could be
    # useful for environments which deploy a highly customized ~/.ssh/config.
    # The command should contain '%h' to subsitute for the workspace's host
    # and '%p' if custom ports are needed. If this option is set, private_keys,
    # insecure, and timeout are ignored.
    # command: ssh -q %h

  # Whether to automatically restore the previous session's files.
  # If set to false, the user is asked via a prompt.
  auto_restore: true

  ## Workspace wallpaper. Override default six wallpaper with your ASCII art.
  #wallpaper: myAsciiArt
  wallpaper_attr:
    fg: *highlight2
    bg: *background2
  wallpaper_background_attr:
    fg: *default
    bg: *background2

notifications:
  auto_close: 5s
  progress_bar: true
  attr:
    fg: *default
    bg: *background
  background_attr:
    fg: *default
    bg: *background
  frame_charset: *frame_charset

terminal:
  # Default shell to use rather than what's provided by the OS via $SHELL.
  #shell: bash
  # Colors
  attr:
    fg: *default
    bg: *background
  selection_attr:
    flags: reverse
  # Defines the tab name attributes when a bell is received and
  # window is not in focus.
  needs_attention_attr:
    fg: red
    flags: blink
